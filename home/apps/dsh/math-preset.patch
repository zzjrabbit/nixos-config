-# The `web` service and its search provider stay in the host composition; only
-# the model-facing tool is per-session.
-- id: tool-web
-  name: '@deepseek-ai/dsh-tool-web'
+# Local persistent memory. Only the seven core tools are exposed to keep the
+# always-present schema small.
+- id: mcp-engram
+  name: '@deepseek-ai/dsh-mcp-client'
+  config:
+    serverName: engram
+    transport: stdio
+    command: '@engramExecutable@'
+    args:
+      - mcp
+      - --project
+      - math-notes
+      - --tools=mem_save,mem_search,mem_context,mem_session_summary,mem_get_observation,mem_save_prompt,mem_current_project
+    cwd: !!js process.env.DSH_CWD ?? process.cwd()
+    env:
+      ENGRAM_DATA_DIR: '@engramDataDirectory@'
+      ENGRAM_PROJECT: math-notes
+    toolCallTimeoutMs: 30000
+    failOnStartupError: true
+    reconnect:
+      enabled: true
+      initialDelayMs: 500
+      maxDelayMs: 30000
+      maxAttempts: 10
+
+# Warm Lean feedback for snippets, declarations, proof states, and tactics.
+- id: mcp-lean-probe
+  name: '@deepseek-ai/dsh-mcp-client'
+  config:
+    serverName: lean-probe
+    transport: stdio
+    command: '@uvxExecutable@'
+    args: [--from, 'lean-probe==0.4.0', lean-probe, mcp]
+    env:
+      LEAN_PROBE_AUTO_BUILD: '0'
+      UV_PYTHON: '@pythonExecutable@'
+      UV_PYTHON_DOWNLOADS: never
+      UV_NO_MANAGED_PYTHON: '1'
+      UV_ISOLATED: '1'
+    toolCallTimeoutMs: 600000
+
+# API-key-free web search and bounded page extraction.
+- id: mcp-duckduckgo
+  name: '@deepseek-ai/dsh-mcp-client'
   config:
-    fetch: false
-    searchTimeoutMs: 60000
+    serverName: duckduckgo-math-notes
+    transport: stdio
+    command: '@uvxExecutable@'
+    args:
+      - --from
+      - 'duckduckgo-mcp-server[browser]==0.6.1'
+      - duckduckgo-mcp-server
+      - --fetch-backend
+      - auto
+    env:
+      DDG_REGION: wt-wt
+      DDG_SAFE_SEARCH: MODERATE
+      UV_PYTHON: '@pythonExecutable@'
+      UV_PYTHON_DOWNLOADS: never
+      UV_NO_MANAGED_PYTHON: '1'
+      UV_ISOLATED: '1'
+    toolCallTimeoutMs: 120000
